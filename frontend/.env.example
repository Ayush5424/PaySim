# PaySim Local Development Environment Variables

# Optional: Target backend URL for the Vite development proxy (default: http://127.0.0.1:8080)
# VITE_BACKEND_URL=http://127.0.0.1:8080

# Optional: Direct API Base URL (leave empty in local dev to use the Vite proxy, or set if backend is on another origin)
# VITE_API_BASE_URL=
