# ==========================================
# PaySim Environment Configuration Example
# ==========================================

# Active Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/upi_simulation
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=paysim-group
KAFKA_PAYMENT_TOPIC=paysim-payment-events
KAFKA_PAYMENT_DLQ_TOPIC=paysim-payment-dlq

# JWT Security
# Generate with: openssl rand -base64 32
JWT_SECRET=dGhpc2lzYXZlcnlzZWNyZXRrZXlmb3Jqd3R0b2tlbmdlbmVyYXRpb25wYXlzaW0xMjM0NTY3ODkwMTI=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Rate Limiting
AUTH_RATE_LIMIT=30
PAYMENT_RATE_LIMIT=20
GENERAL_RATE_LIMIT=120

# Server Port
PORT=8080
